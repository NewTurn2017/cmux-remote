          }
        }
      }
    },
    "attachment.item.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비됨"
          }
        }
      }
    },
    "attachment.item.staging": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비 중"
          }
        }
      }
    },
    "attachment.item.succeeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드됨"
          }
        }
      }
    },
    "attachment.item.unattempted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not attempted"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 안 함"
          }
        }
      }
    },
    "attachment.item.uploading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploading %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 업로드 중"
          }
        }
      }
    },
    "attachment.photo.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach photo from device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 사진 첨부"
          }
        }
      }
    },
    "notification.test.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This should appear in Inbox and as an iOS banner while the app is in the background."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox에 쌓이고 앱이 백그라운드에 있을 때 iOS 배너로 표시되어야 합니다."
          }
        }
      }
    },
    "notification.test.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux test notification"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 테스트 알림"
          }
        }
      }
    },
    "settings.demo.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore the app without a Mac or Tailscale. Demo workspaces, terminals, and notifications are preloaded. This is also the App Review evaluation path."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이나 Tailscale 없이 앱을 둘러볼 수 있습니다. 데모 워크스페이스, 터미널, 알림이 미리 채워져 있습니다. App Review 평가 경로이기도 합니다."
          }
        }
      }
    },
    "settings.guide.step1.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone and Mac must be on the same tailnet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone과 Mac이 같은 tailnet에 있어야 합니다."
          }
        }
      }
    },
    "settings.guide.step1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start cmux and Tailscale on your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 cmux와 Tailscale을 실행합니다."
          }
        }
      }
    },
    "settings.guide.step2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the relay in Terminal on your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 터미널에서 릴레이를 실행합니다."
          }
        }
      }
    },
    "settings.guide.step3.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A physical device requires binding to 0.0.0.0:4399 or your Tailscale IP."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실기기 연결은 0.0.0.0:4399 또는 Tailscale IP 바인딩이 필요합니다."
          }
        }
      }
    },
    "settings.guide.step3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the listen address in relay.json reachable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "relay.json의 listen 주소에 접근할 수 있게 설정합니다."
          }
        }
      }
    },
    "settings.guide.step4.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a 100.x Tailscale IP or tailnet DNS name. The default port is 4399."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x Tailscale IP 또는 tailnet DNS 이름을 사용합니다. 기본 포트는 4399입니다."
          }
        }
      }
    },
    "settings.guide.step4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the host and port under Mac Connection."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Connection에 host와 port를 입력합니다."
          }
        }
      }
    },
    "settings.guide.step5.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Workspaces appear, you are connected. If not, check the relay and Tailscale on your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces가 표시되면 연결된 것입니다. 표시되지 않으면 Mac의 릴레이와 Tailscale 상태를 확인하세요."
          }
        }
      }
    },
    "settings.guide.step5.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Save and Reconnect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 후 다시 연결을 선택합니다."
          }
        }
      }
    },
    "settings.notifications.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only events that require your input appear as iOS banners. Inbox history and badges remain available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 입력이 필요한 이벤트만 iOS 배너로 표시됩니다. Inbox 기록과 배지는 계속 유지됩니다."
          }
        }
      }
    },
    "settings.notifications.test_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local injection appears in Inbox immediately without waiting for cmux. An iOS banner is requested only when the setting above is enabled. The round-trip status separately verifies the relay → cmux → events.stream path."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 인젝션은 cmux 응답을 기다리지 않고 Inbox에 즉시 표시됩니다. 위 설정을 켠 경우에만 iOS 배너를 요청합니다. 라운드트립 상태는 relay → cmux → events.stream 경로를 별도로 확인합니다."
          }
        }
      }
    },
    "settings.notifications.test_sent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sent, arriving in Inbox shortly"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송됨, 곧 Inbox에 도착합니다"
          }
        }
      }
    },
    "terminal.artifact.accessibility_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$@"
          }
        }
      }
    },
    "terminal.artifact.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show terminal files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 파일 보기"
          }
        }
      }
    },
    "terminal.artifact.button_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows recent uploads and files whose paths are visible in the active terminal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 업로드와 활성 터미널에 경로가 표시된 파일을 보여 줍니다."
          }
        }
      }
    },
    "terminal.artifact.detail.byte_cap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image exceeds the 32 MiB preview limit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 32MiB 미리보기 제한을 초과했습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.corrupt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image data could not be decoded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 데이터를 디코딩할 수 없습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview failed without changing the terminal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널은 변경되지 않았으며 미리보기에 실패했습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.file_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed after it appeared in the terminal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 표시된 후 파일이 변경되었습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only file information is available for this type."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일 형식은 파일 정보만 제공합니다."
          }
        }
      }
    },
    "terminal.artifact.detail.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview is still being prepared."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기를 준비하고 있습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.oversized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is larger than the supported preview size."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 지원되는 미리보기 크기보다 큽니다."
          }
        }
      }
    },
    "terminal.artifact.detail.pixel_cap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image exceeds the 40 megapixel preview limit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 4천만 픽셀 미리보기 제한을 초과했습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is ready to open."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 열 준비가 되었습니다."
          }
        }
      }
    },
    "terminal.artifact.detail.stale": {
      "localizations": {
