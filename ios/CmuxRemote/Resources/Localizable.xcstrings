          "stringUnit": {
            "state": "translated",
            "value": "릴레이 업데이트 필요"
          }
        }
      }
    },
    "attachment.failure.upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload failed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 실패"
          }
        }
      }
    },
    "attachment.file.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 첨부"
          }
        }
      }
    },
    "attachment.file.import_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected files could not be accessed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일에 접근할 수 없습니다."
          }
        }
      }
    },
    "attachment.item.accessibility_status": {
      "localizations": {
