    "attachment.batch.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry failed uploads"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 업로드 다시 시도"
          }
        }
      }
    },
    "attachment.batch.succeeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "uploaded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
