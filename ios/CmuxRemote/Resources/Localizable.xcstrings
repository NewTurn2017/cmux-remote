          }
        }
      }
    },
    "attachment.item.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
