            "value": "Mac에서 자동 업데이트가 꺼져 있어 지금 업데이트할 수 없습니다."
          }
        }
      }
    },
    "settings.relay.request.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay can't update itself right now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 relay는 지금 스스로 업데이트할 수 없습니다."
          }
        }
      }
    },
    "settings.relay.request.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the update. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 시작하지 못했습니다. 다시 시도하세요."
          }
        }
      }
    },
    "settings.relay.adhoc_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad-hoc signed: macOS may ask again for Downloads access after an update."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ad-hoc 서명: 업데이트 뒤 macOS가 다운로드 폴더 권한을 다시 물을 수 있습니다."
          }
        }
      }
    },
    "settings.relay.manual_guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To update, run git pull and then ./scripts/install-launchd.sh on your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트하려면 Mac에서 git pull 후 ./scripts/install-launchd.sh를 실행하세요."
          }
        }
      }
    },
    "settings.relay.manual_link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup guide (README)"
