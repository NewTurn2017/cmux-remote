{
  "sourceLanguage": "en",
  "strings": {
    "workspace.shortcut.option_down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Option Down arrow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 아래쪽 방향키 보내기"
          }
        }
      }
    },
    "workspace.shortcut.option_up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Option Up arrow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 위쪽 방향키 보내기"
          }
        }
      }
    },
    "attachment.batch.aggregate_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment upload progress"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 업로드 진행률"
