    "settings.relay.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the relay now?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 relay를 업데이트할까요?"
          }
        }
      }
    },
    "settings.relay.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay restarts after the update, so this phone disconnects briefly and reconnects automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 뒤 relay가 재시작해 이 폰의 연결이 잠깐 끊겼다가 자동으로 다시 연결됩니다."
          }
        }
      }
    },
    "settings.relay.confirm.action": {
